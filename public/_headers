# Vite fingerprints everything in /assets, so those URLs can never change
# content. Without this they inherit max-age=0, must-revalidate and every
# repeat visit spends a round trip revalidating each one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/projects/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000

/resume.pdf
  Cache-Control: public, max-age=86400

# index.html deliberately keeps the default revalidating policy so a deploy
# is picked up immediately.
